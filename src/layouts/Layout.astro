---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Ro Halfhide — Singer-Songwriter & Producer",
  description = "Ro Halfhide is an alternative pop singer-songwriter and producer from The Netherlands. Heartfelt soulful pop exploring hope, human connection, and belonging.",
  image = "/images/hero-portrait.jpg"
} = Astro.props;

const currentYear = new Date().getFullYear();
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rohalfhide.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
  </head>
  <body class="bg-[#0c0d11] text-zinc-100 min-h-screen flex flex-col font-sans">
    <!-- Clean Minimal Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#0c0d11]/90 backdrop-blur-sm border-b border-zinc-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <!-- Brand -->
        <a href="/" class="flex items-center gap-3">
          <img src="/images/logo.png" alt="Ro Halfhide" class="h-8 w-auto object-contain" />
          <span class="font-display font-semibold text-lg tracking-wide uppercase text-white">
            Ro Halfhide
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-7 text-sm">
          <a href="/#music" class="text-zinc-300 hover:text-white transition-colors">Music</a>
          <a href="/#shows" class="text-zinc-300 hover:text-white transition-colors">Shows</a>
          <a href="/#bio" class="text-zinc-300 hover:text-white transition-colors">Bio</a>
          <a href="/#newsletter" class="text-zinc-300 hover:text-white transition-colors">Newsletter</a>
          <a href="/epk" class="text-zinc-400 hover:text-white transition-colors">EPK</a>
          <a href="https://reaumusic.nl" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-zinc-200 transition-colors">Reau ↗</a>
          <a href="/#contact" class="text-zinc-300 hover:text-white transition-colors font-medium">Contact</a>
        </nav>

        <!-- Mobile Toggle -->
        <button id="mobile-menu-btn" type="button" aria-label="Toggle menu" class="md:hidden text-zinc-300 hover:text-white p-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div id="mobile-menu" class="hidden md:hidden bg-[#0c0d11] border-b border-zinc-800 px-4 py-4 space-y-3 text-sm">
        <a href="/#music" class="block text-zinc-200">Music</a>
        <a href="/#shows" class="block text-zinc-200">Shows</a>
        <a href="/#bio" class="block text-zinc-200">Bio</a>
        <a href="/#newsletter" class="block text-zinc-200">Newsletter</a>
        <a href="/epk" class="block text-zinc-400">EPK</a>
        <a href="https://reaumusic.nl" target="_blank" rel="noopener noreferrer" class="block text-zinc-400">Reau ↗</a>
        <a href="/#contact" class="block text-white font-medium">Contact</a>
      </div>
    </header>

    <main class="flex-grow pt-16">
      <slot />
    </main>

    <!-- Clean Footer -->
    <footer class="bg-[#090a0d] border-t border-zinc-900 text-zinc-400 py-12 text-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-3">
            <img src="/images/logo.png" alt="Ro Halfhide" class="h-6 w-auto" />
            <span class="text-white font-medium">Ro Halfhide</span>
          </div>

          <div class="flex items-center gap-6 text-xs text-zinc-400">
            <a href="https://instagram.com/rohalfhide" target="_blank" rel="noopener noreferrer" class="hover:text-white">Instagram</a>
            <a href="https://youtube.com/rohalfhide" target="_blank" rel="noopener noreferrer" class="hover:text-white">YouTube</a>
            <a href="https://rohalfhide.bandcamp.com" target="_blank" rel="noopener noreferrer" class="hover:text-white">Bandcamp</a>
            <a href="https://soundcloud.com/rohalfhide" target="_blank" rel="noopener noreferrer" class="hover:text-white">SoundCloud</a>
          </div>

          <p class="text-xs text-zinc-400">
            © {currentYear} Ro Halfhide
          </p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => menu.classList.toggle('hidden'));
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => menu.classList.add('hidden'));
        });
      }
    </script>
  </body>
</html>
