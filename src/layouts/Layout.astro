---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Ro Halfhide — Singer-Songwriter & Producer",
  description = "Ro Halfhide is an alternative pop singer-songwriter and producer from The Netherlands. Heartfelt soulful pop exploring hope, human connection, and belonging.",
  image = "/images/hero-portrait.jpg"
} = Astro.props;

const currentYear = new Date().getFullYear();
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rohalfhide.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
  </head>
  <body class="bg-[#0c0d11] text-zinc-100 min-h-screen flex flex-col selection:bg-brand-accent selection:text-black">
    <!-- Header / Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#0c0d11]/85 backdrop-blur-md border-b border-zinc-800/60 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/images/logo.png" alt="Ro Halfhide Logo" class="h-10 w-auto object-contain transition-transform group-hover:scale-105" />
          <span class="font-display font-bold text-xl tracking-wider uppercase text-white group-hover:text-brand-accent transition-colors">
            Ro Halfhide
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
          <a href="/#music" class="text-zinc-300 hover:text-brand-accent transition-colors">Muziek</a>
          <a href="/#shows" class="text-zinc-300 hover:text-brand-accent transition-colors">Shows</a>
          <a href="/#bio" class="text-zinc-300 hover:text-brand-accent transition-colors">Over Ro</a>
          <a href="/#newsletter" class="text-zinc-300 hover:text-brand-accent transition-colors">Nieuwsbrief</a>
          <a href="https://reaumusic.nl" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-brand-amber transition-colors flex items-center gap-1">
            Reau (Cover Act)
            <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
          <a href="/epk" class="px-3 py-1 text-xs uppercase tracking-wider rounded border border-zinc-700 hover:border-brand-accent text-zinc-300 hover:text-brand-accent transition-colors">
            EPK
          </a>
          <a href="/#contact" class="px-4 py-2 bg-brand-accent hover:bg-orange-500 text-black font-semibold rounded-full shadow-lg transition-all hover:scale-105">
            Contact & Boekingen
          </a>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" type="button" aria-label="Toggle menu" class="md:hidden text-zinc-300 hover:text-white p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden bg-[#121319] border-b border-zinc-800 px-4 py-6 space-y-4">
        <a href="/#music" class="block text-zinc-200 hover:text-brand-accent text-lg font-medium">Muziek</a>
        <a href="/#shows" class="block text-zinc-200 hover:text-brand-accent text-lg font-medium">Shows</a>
        <a href="/#bio" class="block text-zinc-200 hover:text-brand-accent text-lg font-medium">Over Ro</a>
        <a href="/#newsletter" class="block text-zinc-200 hover:text-brand-accent text-lg font-medium">Nieuwsbrief</a>
        <a href="https://reaumusic.nl" target="_blank" rel="noopener noreferrer" class="block text-zinc-400 hover:text-brand-amber text-lg">
          Reau (Cover Act) ↗
        </a>
        <a href="/epk" class="block text-zinc-400 hover:text-brand-accent text-lg font-medium">EPK (Perskit)</a>
        <a href="/#contact" class="block text-center px-4 py-3 bg-brand-accent text-black font-semibold rounded-lg shadow-md">
          Contact & Boekingen
        </a>
      </div>
    </header>

    <main class="flex-grow pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#08090b] border-t border-zinc-800/80 text-zinc-400 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          <!-- Col 1: Artist Intro -->
          <div class="md:col-span-2 space-y-4">
            <div class="flex items-center gap-3">
              <img src="/images/logo.png" alt="Ro Halfhide" class="h-10 w-auto" />
              <span class="font-display font-bold text-xl uppercase tracking-wider text-white">Ro Halfhide</span>
            </div>
            <p class="text-zinc-400 text-sm leading-relaxed max-w-md">
              Alternative pop singer-songwriter & producer. Muziek vol ziel, verbinding en de overtuiging dat iedereen erbij hoort.
            </p>
            <div class="flex items-center gap-4 pt-2">
              <a href="https://instagram.com/rohalfhide" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded-full bg-zinc-800/70 hover:bg-brand-accent hover:text-black flex items-center justify-center transition-colors text-white">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
              <a href="https://youtube.com/rohalfhide" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-10 h-10 rounded-full bg-zinc-800/70 hover:bg-brand-accent hover:text-black flex items-center justify-center transition-colors text-white">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
              <a href="https://soundcloud.com/rohalfhide" target="_blank" rel="noopener noreferrer" aria-label="SoundCloud" class="w-10 h-10 rounded-full bg-zinc-800/70 hover:bg-brand-accent hover:text-black flex items-center justify-center transition-colors text-white">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M1.175 12.225c-.051 0-.094.045-.101.1l-.273 2.378.273 2.342c.007.058.05.098.101.098.053 0 .094-.04.101-.098l.067-2.342-.067-2.378c-.007-.055-.048-.1-.101-.1zm-.913 1.157c-.053 0-.094.043-.101.099l-.161 1.221.161 1.226c.007.058.048.097.101.097.051 0 .094-.039.098-.097l.042-1.226-.042-1.221c-.004-.056-.047-.099-.098-.099zm1.826-1.745c-.056 0-.101.045-.108.102l-.337 2.923.337 2.871c.007.058.052.1.108.1.055 0 .1-.042.107-.1l.078-2.871-.078-2.923c-.007-.057-.052-.102-.107-.102zm.914-.08c-.061 0-.108.047-.116.107l-.372 3.003.372 2.946c.008.061.055.105.116.105.059 0 .108-.044.116-.105l.088-2.946-.088-3.003c-.008-.06-.057-.107-.116-.107zm.913-.195c-.066 0-.116.05-.123.116l-.403 3.198.403 3.125c.007.065.057.114.123.114.064 0 .117-.049.123-.114l.099-3.125-.099-3.198c-.006-.066-.059-.116-.123-.116zm.914-.523c-.07 0-.126.055-.132.126l-.427 3.721.427 3.593c.006.071.062.124.132.124.068 0 .126-.053.131-.124l.11-3.593-.11-3.721c-.005-.071-.063-.126-.131-.126zm.913-.538c-.075 0-.133.059-.142.137l-.445 4.259.445 4.077c.009.076.067.132.142.132.074 0 .135-.056.14-.132l.121-4.077-.121-4.259c-.005-.078-.066-.137-.14-.137zm.914-.403c-.08 0-.142.064-.15.146l-.458 4.662.458 4.437c.008.082.07.142.15.142.078 0 .144-.06.149-.142l.132-4.437-.132-4.662c-.005-.082-.071-.146-.149-.146zm.914-.378c-.085 0-.152.068-.158.156l-.472 5.04.472 4.774c.006.088.073.153.158.153.083 0 .15-.065.158-.153l.142-4.774-.142-5.04c-.008-.088-.075-.156-.158-.156zm.913.315c-.09 0-.16.074-.168.167l-.48 4.725.48 4.542c.008.093.078.164.168.164.088 0 .16-.071.166-.164l.15-4.542-.15-4.725c-.006-.093-.078-.167-.166-.167zm.914-.728c-.096 0-.169.079-.176.178l-.489 5.453.489 5.176c.007.098.08.176.176.176.094 0 .17-.078.176-.176l.161-5.176-.161-5.453c-.006-.099-.082-.178-.176-.178zm.914-.521c-.1 0-.177.085-.185.188l-.496 5.974.496 5.626c.008.103.085.185.185.185.097 0 .177-.082.184-.185l.17-5.626-.17-5.974c-.007-.103-.087-.188-.184-.188zm1.036-.454c-.114 0-.2.096-.205.213l-.488 6.427.488 6.002c.005.116.091.209.205.209.112 0 .204-.093.208-.209l.177-6.002-.177-6.427c-.004-.117-.096-.213-.208-.213zm4.568-1.579c-.58 0-1.13.161-1.604.445l-.261-2.905c-.007-.123-.105-.224-.225-.224-.122 0-.222.101-.228.224l-.448 8.887.448 5.753c.006.122.106.221.228.221.12 0 .218-.099.225-.221l.248-2.613c.484.29 1.052.457 1.617.457 1.834 0 3.327-1.492 3.327-3.327 0-1.834-1.493-3.327-3.327-3.327z"/></svg>
              </a>
              <a href="https://rohalfhide.bandcamp.com" target="_blank" rel="noopener noreferrer" aria-label="Bandcamp" class="px-3 py-1.5 rounded-full bg-zinc-800/70 hover:bg-brand-accent hover:text-black text-xs font-semibold uppercase tracking-wider text-white transition-colors">
                Bandcamp
              </a>
            </div>
          </div>

          <!-- Col 2: Navigation Links -->
          <div>
            <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Navigatie</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/#music" class="hover:text-brand-accent transition-colors">Muziek & Releases</a></li>
              <li><a href="/#shows" class="hover:text-brand-accent transition-colors">Shows & Agenda</a></li>
              <li><a href="/#bio" class="hover:text-brand-accent transition-colors">Biografie</a></li>
              <li><a href="/#newsletter" class="hover:text-brand-accent transition-colors">Nieuwsbrief</a></li>
              <li><a href="/epk" class="hover:text-brand-accent transition-colors">Electronic Press Kit (EPK)</a></li>
              <li><a href="https://reaumusic.nl" target="_blank" rel="noopener noreferrer" class="hover:text-brand-amber transition-colors">Reau Cover Act ↗</a></li>
            </ul>
          </div>

          <!-- Col 3: Studio & Contact -->
          <div>
            <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Studio & Boekingen</h3>
            <div class="space-y-2 text-sm text-zinc-300">
              <p class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                Jupiterkade 2, Den Haag
              </p>
              <p class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                <a href="mailto:halfhide@gmail.com" class="hover:text-brand-accent transition-colors">halfhide@gmail.com</a>
              </p>
              <p class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <a href="tel:+31628884143" class="hover:text-brand-accent transition-colors">+31 6 28884143</a>
              </p>
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-zinc-800/60 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-400 gap-4">
          <p>© {currentYear} Ro Halfhide. All rights reserved.</p>
          <p class="flex items-center gap-1">
            Gebouwd met <span class="text-brand-accent">Astro</span> & gehost op <span class="text-brand-accent font-medium">Netlify</span>.
          </p>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Toggle Script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');

      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });

        // Close menu on link click
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
          });
        });
      }
    </script>
  </body>
</html>
