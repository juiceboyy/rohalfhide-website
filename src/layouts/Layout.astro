---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Ro Halfhide - Singer-Songwriter & Producer",
  description = "Ro Halfhide is an alternative pop singer-songwriter and producer from The Netherlands. Heartfelt soulful pop exploring hope, human connection, and belonging.",
  image = "/images/hero-portrait.jpg"
} = Astro.props;

const currentYear = new Date().getFullYear();
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rohalfhide.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Editorial Serif (Playfair Display), Geometric Sans (Plus Jakarta Sans), Technical Mono (JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
  </head>
  <body class="bg-surface-void text-surface-ink min-h-screen flex flex-col font-sans font-normal">
    <!-- Architectural Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface-void/85 backdrop-blur-xl shadow-divider-b">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Brand Wordmark -->
        <a href="/" aria-label="Ro Halfhide Home" class="inline-flex items-center rounded-sm focus-ring">
          <img
            src="/images/logo-header.webp"
            alt="Ro Halfhide"
            width="478"
            height="265"
            class="h-8 sm:h-9 w-auto object-contain"
          />
        </a>

        <!-- Desktop Navigation -->
        <nav aria-label="Primary" class="hidden md:flex items-center gap-8 text-xs font-mono font-medium uppercase tracking-[0.16em]">
          <a href="/#music" class="text-surface-muted hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">Music</a>
          <a href="/#shows" class="text-surface-muted hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">Shows</a>
          <a href="/#news" class="text-surface-muted hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">News</a>
          <a href="/#bio" class="text-surface-muted hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">Bio</a>
          <a href="/#newsletter" class="text-surface-muted hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">Newsletter</a>
          <a href="/epk" class="text-surface-muted hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">EPK</a>
          <a
            href="https://reaumusic.nl"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-surface-subtle hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring"
          >
            <span>Reau</span>
            <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 17L17 7M9 7h8v8"></path>
            </svg>
          </a>
          <a href="/#contact" class="text-accent hover:text-accent-hover transition-colors duration-150 rounded-sm focus-ring">Contact</a>
        </nav>

        <!-- Mobile Toggle -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden text-surface-muted hover:text-surface-ink p-2 rounded-sm focus-ring"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 7h16M4 12h16M10 17h10"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div
        id="mobile-menu"
        class="hidden md:hidden bg-surface-base/95 backdrop-blur-xl shadow-divider-b px-6 py-6 space-y-4 text-xs font-mono font-medium uppercase tracking-[0.16em]"
      >
        <a href="/#music" class="block py-1 text-surface-ink rounded-sm focus-ring">Music</a>
        <a href="/#shows" class="block py-1 text-surface-ink rounded-sm focus-ring">Shows</a>
        <a href="/#news" class="block py-1 text-surface-ink rounded-sm focus-ring">News</a>
        <a href="/#bio" class="block py-1 text-surface-ink rounded-sm focus-ring">Bio</a>
        <a href="/#newsletter" class="block py-1 text-surface-ink rounded-sm focus-ring">Newsletter</a>
        <a href="/epk" class="block py-1 text-surface-muted rounded-sm focus-ring">EPK</a>
        <a
          href="https://reaumusic.nl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 py-1 text-surface-muted rounded-sm focus-ring"
        >
          <span>Reau</span>
          <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 17L17 7M9 7h8v8"></path>
          </svg>
        </a>
        <a href="/#contact" class="block py-1 text-accent rounded-sm focus-ring">Contact</a>
      </div>
    </header>

    <main class="flex-grow pt-16">
      <slot />
    </main>

    <!-- Editorial Footer -->
    <footer class="bg-surface-void shadow-divider-t text-surface-muted py-16">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-4">
          <img
            src="/images/logo-header.webp"
            alt="Ro Halfhide"
            width="478"
            height="265"
            loading="lazy"
            class="h-7 w-auto object-contain opacity-90"
          />
        </div>

        <div class="md:col-span-5 flex flex-wrap items-center gap-6 text-xs font-mono uppercase tracking-[0.16em] text-surface-muted">
          <a href="/news" class="hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">News</a>
          <a href="https://instagram.com/rohalfhide" target="_blank" rel="noopener noreferrer" class="hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">Instagram</a>
          <a href="https://youtube.com/rohalfhide" target="_blank" rel="noopener noreferrer" class="hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">YouTube</a>
          <a href="https://rohalfhide.bandcamp.com" target="_blank" rel="noopener noreferrer" class="hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">Bandcamp</a>
          <a href="https://soundcloud.com/rohalfhide" target="_blank" rel="noopener noreferrer" class="hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">SoundCloud</a>
          <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="hover:text-surface-ink transition-colors duration-150 rounded-sm focus-ring">RSS</a>
        </div>

        <p class="md:col-span-3 md:text-right font-mono text-xs text-surface-subtle">
          &copy; {currentYear} Ro Halfhide
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/form-validation';

      function initMobileNav() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;

        const closeMenu = () => {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        };

        btn.addEventListener('click', () => {
          const isHidden = menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!isHidden));
        });

        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
            closeMenu();
            btn.focus();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMobileNav);
      } else {
        initMobileNav();
      }
    </script>
  </body>
</html>
