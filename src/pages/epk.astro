---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="EPK — Ro Halfhide"
  description="Electronic Press Kit for programmers, venues, and media."
>
  <div class="py-16 max-w-4xl mx-auto px-4 sm:px-6 space-y-12">
    <!-- Header -->
    <div class="border-b border-zinc-800/80 pb-6">
      <h1 class="font-display text-3xl sm:text-4xl font-bold text-white">Electronic Press Kit</h1>
      <p class="text-zinc-400 text-sm mt-1">Official materials for bookers, programmers, and press.</p>
    </div>

    <!-- Photos Section -->
    <section class="space-y-4">
      <h2 class="font-display text-xl font-bold text-white">Photos</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="space-y-2">
          <img src="/images/hero-portrait.jpg" alt="Ro Halfhide Portrait" class="w-full h-56 object-cover rounded bg-zinc-900" />
          <a href="/images/hero-portrait.jpg" download class="text-xs text-zinc-300 underline hover:text-white block">
            Download portrait (High-Res)
          </a>
        </div>
        <div class="space-y-2">
          <img src="/images/about-banner.webp" alt="Ro Halfhide Live" class="w-full h-56 object-cover rounded bg-zinc-900" />
          <a href="/images/about-banner.webp" download class="text-xs text-zinc-300 underline hover:text-white block">
            Download live shot (High-Res)
          </a>
        </div>
        <div class="space-y-2">
          <img src="/images/its-been-good.jpg" alt="It's been good artwork" class="w-full h-56 object-cover rounded bg-zinc-900" />
          <a href="/images/its-been-good.jpg" download class="text-xs text-zinc-300 underline hover:text-white block">
            Download single artwork
          </a>
        </div>
      </div>
    </section>

    <!-- Bio Section -->
    <section class="space-y-6">
      <h2 class="font-display text-xl font-bold text-white">Bio</h2>

      <div class="space-y-3">
        <h3 class="text-xs uppercase tracking-wider text-zinc-400 font-semibold">Short Bio</h3>
        <p class="text-zinc-300 text-sm leading-relaxed">
          Ro Halfhide is an alternative pop singer-songwriter and producer from The Netherlands. Known for his soulful vocal delivery and heartfelt melodies that speak straight to the heart, his music reflects real life experiences with an unwavering message of hope, connection, and belonging.
        </p>
      </div>

      <div class="space-y-3 pt-4 border-t border-zinc-800/60">
        <h3 class="text-xs uppercase tracking-wider text-zinc-400 font-semibold">Full Bio</h3>
        <div class="text-zinc-300 text-sm leading-relaxed space-y-3">
          <p>
            Ro Halfhide is a singer-songwriter whose music aims to recharge listeners, provide hope, and foster connection. His pop songs are infused with soul and offer a reflection of real life experiences, both the highs and lows, with lyrics and melodies that speak directly to the heart.
          </p>
          <p>
            Ro's background as a fusion of two cultures is a source of inspiration for him in his search for connection in his music and life. The central theme in his music is the message that everyone belongs.
          </p>
          <p>
            Ro has been on Dutch national TV numerous times, in the last years with his band for mentally handicapped people Wimpie & de Domino's. He has also produced albums for well-known singer-songwriters like Lucky Fonz III and Case Mayfield, toured across Indonesia with Robin Block, and co-founded the Amsterdam Songwriters Guild.
          </p>
        </div>
      </div>
    </section>

    <!-- Tech / Booking -->
    <section class="pt-6 border-t border-zinc-800/60 space-y-2 text-sm text-zinc-400">
      <h2 class="font-display text-xl font-bold text-white mb-2">Technical & Booking</h2>
      <p>
        Available for solo, acoustic duo, and band setups. Standard stage monitoring and DI channels required.
      </p>
      <p>
        Direct inquiries & stage plot requests: <a href="mailto:halfhide@gmail.com" class="text-zinc-200 underline">halfhide@gmail.com</a> / +31 6 28884143.
      </p>
    </section>
  </div>
</Layout>
