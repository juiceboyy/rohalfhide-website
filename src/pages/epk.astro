---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="EPK - Ro Halfhide"
  description="Electronic Press Kit for programmers, venues, and media."
>
  <div class="py-24 max-w-6xl mx-auto px-6 lg:px-8 space-y-24">
    <!-- Asymmetric Editorial Header -->
    <div class="pb-12 shadow-divider-b grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
      <div class="lg:col-span-8">
        <h1 class="font-serif font-semibold text-4xl sm:text-6xl lg:text-7xl tracking-[-0.04em] leading-[1.02] text-surface-ink">
          Electronic Press Kit
        </h1>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <p class="font-sans font-normal text-base text-surface-muted leading-relaxed">
          Official materials for bookers, programmers, and press.
        </p>
      </div>
    </div>

    <!-- Asymmetric Bento Press Photos Spread -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-4 space-y-3">
        <h2 class="font-serif font-semibold text-3xl sm:text-4xl tracking-[-0.035em] leading-[1.08] text-surface-ink">
          Photos
        </h2>
        <p class="font-sans font-normal text-sm text-surface-muted leading-relaxed">
          High-resolution downloads for editorial and promotional use.
        </p>
      </div>

      <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-12 gap-6">
        <!-- Row 1: 7 / 5 Asymmetric Split -->
        <div class="md:col-span-7 bg-surface-raised rounded-2xl overflow-hidden shadow-hairline flex flex-col justify-between">
          <img
            src="/images/about-banner.webp"
            alt="Ro Halfhide Live"
            width="2880"
            height="1680"
            fetchpriority="high"
            class="w-full h-64 sm:h-72 object-cover"
          />
          <div class="px-6 py-4 shadow-divider-t flex items-center justify-between">
            <a
              href="/images/about-banner.webp"
              download
              class="font-mono font-medium text-xs uppercase tracking-[0.16em] text-accent hover:text-accent-hover transition-colors duration-150 rounded-sm focus-ring"
            >
              Live Shot (High-Res) &darr;
            </a>
          </div>
        </div>

        <div class="md:col-span-5 bg-surface-raised rounded-2xl overflow-hidden shadow-hairline flex flex-col justify-between">
          <img
            src="/images/hero-portrait.jpg"
            alt="Ro Halfhide Portrait"
            width="1748"
            height="1748"
            class="w-full h-64 sm:h-72 object-cover object-top"
          />
          <div class="px-6 py-4 shadow-divider-t flex items-center justify-between">
            <a
              href="/images/hero-portrait.jpg"
              download
              class="font-mono font-medium text-xs uppercase tracking-[0.16em] text-accent hover:text-accent-hover transition-colors duration-150 rounded-sm focus-ring"
            >
              Portrait (High-Res) &darr;
            </a>
          </div>
        </div>

        <!-- Row 2: 5 / 7 Asymmetric Split -->
        <div class="md:col-span-5 bg-surface-raised rounded-2xl overflow-hidden shadow-hairline flex flex-col justify-between">
          <img
            src="/images/its-been-good.jpg"
            alt="It's been good artwork"
            width="3024"
            height="3024"
            class="w-full h-60 sm:h-64 object-cover"
          />
          <div class="px-6 py-4 shadow-divider-t flex items-center justify-between">
            <a
              href="/images/its-been-good.jpg"
              download
              class="font-mono font-medium text-xs uppercase tracking-[0.16em] text-accent hover:text-accent-hover transition-colors duration-150 rounded-sm focus-ring"
            >
              Single Artwork &darr;
            </a>
          </div>
        </div>

        <div class="md:col-span-7 bg-surface-raised rounded-2xl overflow-hidden shadow-hairline flex flex-col justify-between">
          <img
            src="/images/cover-act.jpg"
            alt="Ro Halfhide Acoustic"
            width="1413"
            height="2000"
            class="w-full h-60 sm:h-64 object-cover object-[center_22%]"
          />
          <div class="px-6 py-4 shadow-divider-t flex items-center justify-between">
            <a
              href="/images/cover-act.jpg"
              download
              class="font-mono font-medium text-xs uppercase tracking-[0.16em] text-accent hover:text-accent-hover transition-colors duration-150 rounded-sm focus-ring"
            >
              Acoustic Portrait (High-Res) &darr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Bio Spread -->
    <section class="pt-16 shadow-divider-t grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-4">
        <h2 class="font-serif font-semibold text-3xl sm:text-4xl tracking-[-0.035em] leading-[1.08] text-surface-ink">
          Bio
        </h2>
      </div>

      <div class="lg:col-span-8 space-y-12">
        <div class="space-y-4">
          <h3 class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle">
            Short Bio
          </h3>
          <p class="font-sans font-normal text-lg leading-relaxed text-surface-ink">
            Ro Halfhide is an alternative pop singer-songwriter and producer from The Netherlands. Known for his soulful vocal delivery and heartfelt melodies that speak straight to the heart, his music reflects real life experiences with an unwavering message of hope, connection, and belonging.
          </p>
        </div>

        <div class="pt-8 shadow-divider-t space-y-4">
          <h3 class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle">
            Full Bio
          </h3>
          <div class="font-sans font-normal text-base leading-relaxed text-surface-ink/85 space-y-4">
            <p>
              Ro Halfhide is a singer-songwriter whose music aims to recharge listeners, provide hope, and foster connection. His pop songs are infused with soul and offer a reflection of real life experiences, both the highs and lows, with lyrics and melodies that speak directly to the heart.
            </p>
            <p>
              Ro's background as a fusion of two cultures is a source of inspiration for him in his search for connection in his music and life. The central theme in his music is the message that everyone belongs.
            </p>
            <p>
              Ro has been on Dutch national TV numerous times, in the last years with his band for mentally handicapped people Wimpie &amp; de Domino's. He has also produced albums for well-known singer-songwriters like Lucky Fonz III and Case Mayfield, toured across Indonesia with Robin Block, and co-founded the Amsterdam Songwriters Guild.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical & Booking Spread -->
    <section class="pt-16 shadow-divider-t grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-4">
        <h2 class="font-serif font-semibold text-3xl sm:text-4xl tracking-[-0.035em] leading-[1.08] text-surface-ink">
          Technical &amp; Booking
        </h2>
      </div>

      <div class="lg:col-span-8 space-y-4 font-sans font-normal text-base text-surface-muted leading-relaxed">
        <p class="text-surface-ink">
          Available for solo, acoustic duo, and band setups. Standard stage monitoring and DI channels required.
        </p>
        <p>
          Direct inquiries &amp; stage plot requests: <a
            href="mailto:halfhide@gmail.com"
            class="text-accent hover:text-accent-hover underline underline-offset-4 transition-colors duration-150 rounded-sm focus-ring"
          >halfhide@gmail.com</a> / <a
            href="tel:+31628884143"
            class="font-mono text-sm text-surface-ink hover:text-accent transition-colors duration-150 rounded-sm focus-ring"
          >+31 6 28884143</a>.
        </p>
      </div>
    </section>
  </div>
</Layout>
