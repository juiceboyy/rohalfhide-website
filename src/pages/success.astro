---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Message Sent - Ro Halfhide"
  description="Thank you for getting in touch. We will get back to you as soon as possible."
>
  <section class="min-h-[75vh] flex items-center justify-center py-24 px-6">
    <div class="max-w-lg w-full bg-surface-raised rounded-2xl shadow-hairline p-8 sm:p-12 space-y-6">
      <p class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-accent">
        Confirmation
      </p>

      <h1 class="font-serif font-semibold text-4xl sm:text-5xl tracking-[-0.04em] leading-[1.05] text-surface-ink">
        Thank You
      </h1>

      <p class="font-sans font-normal text-base text-surface-muted leading-relaxed">
        Your message has been received. Ro or his team will get back to you shortly.
      </p>

      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-8 py-4 bg-surface-ink hover:bg-white text-surface-void font-mono font-medium text-xs uppercase tracking-[0.16em] rounded-lg transition-colors duration-150 focus-ring"
        >
          <span aria-hidden="true">&larr;</span>
          <span>Back to Homepage</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
