---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Bericht Verzonden — Ro Halfhide"
  description="Bedankt voor je bericht. We nemen zo spoedig mogelijk contact met je op."
>
  <section class="min-h-[70vh] flex items-center justify-center py-20 px-4">
    <div class="max-w-md w-full bg-[#151720] border border-zinc-800 rounded-2xl p-8 sm:p-10 text-center shadow-2xl">
      <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h1 class="font-display text-3xl font-bold text-white mb-3">Bedankt voor je bericht!</h1>
      <p class="text-zinc-400 text-sm leading-relaxed mb-8">
        Het formulier is succesvol ontvangen via Netlify. Ro of zijn management neemt binnenkort contact met je op.
      </p>

      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-3 bg-brand-accent hover:bg-orange-500 text-black font-semibold rounded-xl text-sm transition-all hover:scale-105"
      >
        ← Terug naar de homepage
      </a>
    </div>
  </section>
</Layout>
