    iconPath: "M0 18.75l7.437-13.5H24l-7.438 13.5H0z"
  },
  {
    name: "SoundCloud",
    url: "https://soundcloud.com/rohalfhide",
    iconPath: "M11.56 8.87V17h9.72c1.5 0 2.72-1.22 2.72-2.72 0-1.47-1.17-2.66-2.63-2.71-.31-2.48-2.41-4.4-4.97-4.4-1.07 0-2.07.34-2.88.92-.48-.73-1.18-1.32-2-1.68v2.46zm-2.04 1.54v6.59H10.6V9.28c-.39.31-.76.7-1.08 1.13zm-2.04 1.83v4.76h1.08v-5.4c-.39.18-.75.4-1.08.64zm-2.04.59v4.17h1.08v-4.59c-.38.11-.75.25-1.08.42zm-2.04 1.25v2.92h1.08v-3.32c-.37.1-.73.23-1.08.4zm-2.04.91v2.01h1.08v-2.31c-.37.07-.73.17-1.08.3zm-1.36.9v1.11H1.08V16c-.36.03-.73.08-1.08.16z"
  },
  {
    name: "YouTube",
