  {
    name: "Spotify",
    url: "https://open.spotify.com/artist/79dS9zvJ6QCjz54EUdjs9u",
    iconPath: "M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.503 17.309c-.216.354-.675.467-1.03.25-2.822-1.724-6.375-2.114-10.56-1.159-.404.092-.81-.161-.902-.565-.092-.404.161-.81.565-.902 4.58-1.047 8.508-.604 11.677 1.346.355.217.467.676.25 1.03zm1.47-3.27c-.272.443-.852.585-1.295.313-3.23-1.986-8.156-2.56-11.977-1.4-4.99.151-.97-.184-1.12-.684-.152-.499.184-.97.683-1.121 4.38-1.33 9.808-.686 13.396 1.597.443.272.585.852.313 1.295zm.127-3.407C15.23 8.358 8.847 8.147 5.153 9.269c-.59.179-1.218-.16-1.397-.75-.179-.59.16-1.218.75-1.397 4.244-1.288 11.294-1.043 15.753 1.603.531.315.703 1.002.388 1.533-.314.531-1.002.703-1.533.388z"
  },
  {
