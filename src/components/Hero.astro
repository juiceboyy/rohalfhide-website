---
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-portrait.jpg"
      alt="Ro Halfhide"
      class="w-full h-full object-cover object-center filter brightness-[0.6] contrast-[1.1]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0c0d11] via-[#0c0d11]/60 to-[#0c0d11]/40"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0c0d11]/80 via-transparent to-[#0c0d11]/80"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-brand-amber text-xs uppercase tracking-widest font-semibold mb-6 animate-pulse">
      <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
      Nieuwe Single: "It's Been Good" Nu Uit
    </div>

    <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-6 uppercase">
      Ro Halfhide
    </h1>

    <p class="text-lg sm:text-2xl text-zinc-300 font-light max-w-2xl mx-auto mb-10 leading-relaxed">
      Muziek vol ziel die oplaadt, hoop biedt en verbindt.
      <span class="block text-brand-amber font-normal mt-1">"The central theme: everyone belongs."</span>
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
      <a
        href="#music"
        class="px-8 py-3.5 bg-brand-accent hover:bg-orange-500 text-black font-semibold rounded-full shadow-lg hover:shadow-orange-500/25 transition-all hover:scale-105 flex items-center gap-2"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        Beluister Muziek
      </a>
      <a
        href="#shows"
        class="px-8 py-3.5 bg-zinc-900/80 hover:bg-zinc-850 text-white font-medium rounded-full border border-zinc-700 hover:border-brand-accent transition-all hover:scale-105 flex items-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Tourdata & Shows
      </a>
      <a
        href="#contact"
        class="px-6 py-3.5 text-zinc-300 hover:text-brand-accent font-medium transition-colors"
      >
        Boekingen & Contact →
      </a>
    </div>

    <!-- Badges / Highlights -->
    <div class="pt-8 border-t border-zinc-800/80 max-w-3xl mx-auto grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs text-zinc-400">
      <div>
        <p class="text-white font-semibold text-sm">Songwriters Guild</p>
        <p>Mede-oprichter Amsterdam</p>
      </div>
      <div>
        <p class="text-white font-semibold text-sm">Producer & Artist</p>
        <p>Lucky Fonz III, Case Mayfield</p>
      </div>
      <div class="col-span-2 sm:col-span-1">
        <p class="text-white font-semibold text-sm">Live & TV</p>
        <p>Wimpie & de Domino's</p>
      </div>
    </div>
  </div>
</section>
