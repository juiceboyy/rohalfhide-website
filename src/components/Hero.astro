---
---

<section class="relative min-h-[75vh] flex items-center justify-center">
  <!-- Background Image with Clean Dimming -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-portrait.jpg"
      alt="Ro Halfhide"
      class="w-full h-full object-cover object-center filter brightness-[0.5]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0c0d11] via-transparent to-[#0c0d11]/40"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h1 class="font-display font-bold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-6">
      Ro Halfhide
    </h1>

    <p class="text-xl sm:text-2xl text-zinc-300 font-light max-w-2xl mx-auto mb-10 leading-relaxed">
      Alternative pop & soul. Songs about life, hope, and connection.
    </p>

    <!-- Clean, understated navigation actions -->
    <div class="flex flex-wrap items-center justify-center gap-4 text-sm">
      <a
        href="#music"
        class="px-6 py-3 bg-white hover:bg-zinc-200 text-black font-medium rounded-md transition-colors"
      >
        Listen
      </a>
      <a
        href="#shows"
        class="px-6 py-3 bg-zinc-900/80 hover:bg-zinc-800 text-white font-medium rounded-md border border-zinc-700 transition-colors"
      >
        Tour Dates
      </a>
      <a
        href="#contact"
        class="px-6 py-3 text-zinc-300 hover:text-white font-medium transition-colors"
      >
        Contact
      </a>
    </div>
  </div>
</section>
