---
---

<div
  id="track-editor-modal"
  class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md overflow-y-auto p-4 sm:p-6 lg:p-8 flex items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="track-modal-title"
>
  <div class="bg-surface-base border border-white/[0.08] rounded-2xl w-full max-w-2xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden my-auto">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-white/[0.08] flex items-center justify-between shrink-0 bg-surface-raised/40">
      <div>
        <h2 id="track-modal-title" class="font-serif text-xl font-semibold text-surface-ink">
          Add Track
        </h2>
        <p class="font-sans text-xs text-surface-muted">
          Add a track to the homepage playlist deck with artwork and audio file.
        </p>
      </div>
      <button
        type="button"
        id="track-modal-close-btn"
        class="text-surface-subtle hover:text-surface-ink p-2 rounded-lg transition-colors focus-ring"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Form -->
    <form id="track-form" class="flex-grow overflow-y-auto p-6 space-y-5">
      <input type="hidden" id="track-form-id" />

      <!-- Title & Artist -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1">
          <label for="track-form-title" class="font-mono text-xs text-surface-subtle uppercase">
            Track Title *
          </label>
          <input
            id="track-form-title"
            type="text"
            required
            placeholder="e.g. Evening Sun"
            class="form-input"
          />
        </div>

        <div class="space-y-1">
          <label for="track-form-artist" class="font-mono text-xs text-surface-subtle uppercase">
            Artist *
          </label>
          <input
            id="track-form-artist"
            type="text"
            required
            value="Ro Halfhide"
            class="form-input"
          />
        </div>
      </div>

      <!-- Audio Source & Auto-Duration -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="track-form-src" class="font-mono text-xs text-surface-subtle uppercase">
            Audio File (.mp3) *
          </label>
          <span class="text-[11px] font-sans text-surface-muted">
            Auto-detects duration on upload
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
          <div class="sm:col-span-8">
            <input
              id="track-form-src"
              type="text"
              required
              placeholder="/audio/evening-sun.mp3"
              class="form-input"
            />
          </div>

          <div class="sm:col-span-4 flex gap-2">
            <label class="w-full px-3 py-3 bg-surface-raised hover:bg-white/[0.08] shadow-hairline text-surface-ink rounded-lg text-xs font-sans font-medium cursor-pointer text-center flex items-center justify-center gap-1.5 focus-ring">
              <span>Upload MP3</span>
              <input
                id="track-audio-upload"
                type="file"
                accept=".mp3,audio/mpeg"
                class="hidden"
              />
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
          <div class="space-y-1">
            <label for="track-form-duration" class="font-mono text-xs text-surface-subtle uppercase">
              Duration (m:ss) *
            </label>
            <input
              id="track-form-duration"
              type="text"
              required
              placeholder="3:06"
              class="form-input font-mono"
            />
          </div>

          <div class="space-y-1">
            <label for="track-form-date" class="font-mono text-xs text-surface-subtle uppercase">
              Release Date
            </label>
            <input
              id="track-form-date"
              type="date"
              class="form-input"
            />
          </div>
        </div>
      </div>

      <!-- Cover Artwork -->
      <div class="space-y-2">
        <label for="track-form-cover" class="font-mono text-xs text-surface-subtle uppercase">
          Cover Artwork (Square Image) *
        </label>
        <div class="flex gap-3 items-center">
          <div class="flex-grow">
            <input
              id="track-form-cover"
              type="text"
              required
              placeholder="/images/evening-sun.jpg"
              class="form-input"
            />
          </div>
          <label class="px-4 py-3 bg-surface-raised hover:bg-white/[0.08] shadow-hairline text-surface-ink rounded-lg text-xs font-sans font-medium cursor-pointer shrink-0 flex items-center gap-1.5 focus-ring">
            <span>Upload Image</span>
            <input
              id="track-cover-upload"
              type="file"
              accept="image/*"
              class="hidden"
            />
          </label>
          <img
            id="track-cover-preview"
            src=""
            alt="Preview"
            class="h-11 w-11 object-cover rounded-lg bg-surface-base shadow-hairline hidden shrink-0"
          />
        </div>
      </div>

      <!-- Streaming Links -->
      <div class="space-y-3 pt-2 border-t border-white/[0.06]">
        <span class="block font-mono text-xs text-surface-subtle uppercase">
          Optional Direct Streaming Links
        </span>

        <div class="space-y-2">
          <input
            id="track-form-spotify"
            type="url"
            placeholder="Spotify track URL (https://open.spotify.com/track/...)"
            class="form-input text-xs"
          />
          <input
            id="track-form-bandcamp"
            type="url"
            placeholder="Bandcamp track URL (https://rohalfhide.bandcamp.com/track/...)"
            class="form-input text-xs"
          />
          <input
            id="track-form-apple"
            type="url"
            placeholder="Apple Music track URL"
            class="form-input text-xs"
          />
        </div>
      </div>

      <!-- Draft Toggle -->
      <div class="pt-2 border-t border-white/[0.06]">
        <label class="relative inline-flex items-center cursor-pointer">
          <input
            id="track-form-draft"
            type="checkbox"
            class="sr-only peer"
          />
          <div class="w-11 h-6 bg-surface-raised peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-600/70"></div>
          <span class="ml-3 font-sans text-sm text-surface-muted">
            Save as Draft (hidden from homepage deck)
          </span>
        </label>
      </div>
    </form>

    <!-- Footer -->
    <div class="px-6 py-4 border-t border-white/[0.08] flex items-center justify-between shrink-0 bg-surface-raised/40">
      <button
        type="button"
        id="track-modal-cancel-btn"
        class="px-4 py-2 rounded-lg text-xs font-sans text-surface-muted hover:text-surface-ink transition-colors focus-ring"
      >
        Cancel
      </button>

      <button
        type="submit"
        form="track-form"
        id="track-modal-save-btn"
        class="px-5 py-2.5 rounded-lg bg-surface-ink hover:bg-white text-surface-void text-xs font-sans font-medium transition-colors focus-ring"
      >
        Save Track
      </button>
    </div>
  </div>
</div>
