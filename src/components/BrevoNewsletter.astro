---
---

<section id="newsletter" class="py-16 bg-[#0c0d11] border-t border-zinc-900">
  <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-2">
      Mailing List
    </h2>
    <p class="text-zinc-400 text-sm mb-6">
      Sign up so you won't miss any news, new songs, or show announcements.
    </p>

    <form id="brevo-form" class="space-y-3">
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="email"
          name="EMAIL"
          id="brevo-email"
          required
          placeholder="Your email address"
          class="flex-grow px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded text-white text-sm placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors"
        />
        <button
          type="submit"
          class="px-5 py-2.5 bg-white hover:bg-zinc-200 text-black font-medium rounded text-sm transition-colors"
        >
          Subscribe
        </button>
      </div>
      <div id="brevo-status" class="hidden text-xs text-zinc-300 pt-1"></div>
    </form>
  </div>
</section>

<script>
  const brevoForm = document.getElementById('brevo-form');
  const statusEl = document.getElementById('brevo-status');

  if (brevoForm && statusEl) {
    brevoForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (document.getElementById('brevo-email') as HTMLInputElement)?.value;
      statusEl.classList.remove('hidden');
      statusEl.textContent = `Thank you! You are subscribed with ${email}.`;
      brevoForm.reset();
    });
  }
</script>
