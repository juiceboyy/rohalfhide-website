---
---

<section id="newsletter" class="py-24 bg-surface-base shadow-divider-t">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="bg-surface-raised/60 rounded-2xl shadow-hairline p-8 sm:p-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-6 space-y-3">
        <h2 class="font-serif font-semibold text-3xl sm:text-4xl tracking-[-0.035em] leading-[1.08] text-surface-ink">
          Mailing List
        </h2>
        <p class="font-sans font-normal text-base text-surface-muted leading-relaxed max-w-md">
          Sign up so you won't miss any news, new songs, or show announcements.
        </p>
      </div>

      <div class="lg:col-span-6">
        <form id="brevo-form" action="/api/subscribe" method="POST" class="space-y-2">
          <label for="brevo-email" class="block font-mono font-medium text-xs uppercase tracking-[0.16em] text-surface-muted">
            Email Address
          </label>
          <span id="brevo-email-hint" class="block text-xs text-surface-subtle pb-1">
            Format: name@example.com
          </span>

          <div class="flex flex-col sm:flex-row items-start gap-4">
            <div class="flex-grow w-full">
              <input
                type="email"
                name="EMAIL"
                id="brevo-email"
                required
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                aria-describedby="brevo-email-hint"
                aria-errormessage="brevo-email-error"
                placeholder="you@example.com"
                class="form-input bg-surface-void"
              />
              <p id="brevo-email-error" class="field-error items-center gap-2 text-xs text-red-400 mt-2">
                <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
                </svg>
                <span>Please enter a valid email address.</span>
              </p>
            </div>

            <button
              id="brevo-submit"
              type="submit"
              class="w-full sm:w-auto px-8 py-3 bg-surface-ink hover:bg-white text-surface-void font-mono font-medium text-xs uppercase tracking-[0.16em] rounded-lg transition-colors duration-150 shrink-0 focus-ring disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Subscribe
            </button>
          </div>

          <div id="brevo-status" role="status" aria-live="polite" class="hidden font-mono text-xs pt-2"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  function initBrevoForm() {
    const brevoForm = document.getElementById('brevo-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('brevo-status');
    const emailInput = document.getElementById('brevo-email') as HTMLInputElement | null;
    const submitBtn = document.getElementById('brevo-submit') as HTMLButtonElement | null;

    if (!brevoForm || !statusEl || !submitBtn) return;

    brevoForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!brevoForm.checkValidity()) {
        brevoForm.reportValidity();
        return;
      }

      const email = emailInput?.value.trim() || '';
      if (!email) return;

      const originalLabel = submitBtn.textContent || 'Subscribe';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Subscribing...';
      statusEl.classList.add('hidden');
      statusEl.classList.remove('text-accent', 'text-red-400');

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok) {
          statusEl.classList.add('text-accent');
          statusEl.classList.remove('hidden');
          statusEl.textContent = `Thank you! You are subscribed with ${email}.`;
          brevoForm.reset();
        } else {
          statusEl.classList.add('text-red-400');
          statusEl.classList.remove('hidden');
          statusEl.textContent = data?.error || 'Could not subscribe right now. Please try again later.';
        }
      } catch {
        statusEl.classList.add('text-red-400');
        statusEl.classList.remove('hidden');
        statusEl.textContent = 'Network error. Please try again in a moment.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBrevoForm);
  } else {
    initBrevoForm();
  }
</script>
