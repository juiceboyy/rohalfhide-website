---
---

<section id="contact" class="py-24 bg-[#0a0b0e] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Contact Info (Left) -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <span class="text-brand-accent text-sm font-semibold tracking-widest uppercase">Contact & Boekingen</span>
          <h2 class="font-display text-4xl sm:text-5xl font-bold text-white mt-2 mb-4">Neem Contact Op</h2>
          <p class="text-zinc-400 text-base leading-relaxed">
            Wil je Ro boeken voor een huiskamerconcert, festival, theater of club? Of heb je vragen over songwriting, productie of sync & licensing voor media? Stuur gerust een bericht.
          </p>
        </div>

        <div class="space-y-6 bg-[#13151c] border border-zinc-800 p-6 sm:p-8 rounded-2xl">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm">Opnamestudio</h4>
              <p class="text-zinc-400 text-sm">Jupiterkade 2</p>
              <p class="text-zinc-400 text-sm">Den Haag, Nederland</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm">E-mail</h4>
              <a href="mailto:halfhide@gmail.com" class="text-brand-amber hover:underline text-sm font-medium">
                halfhide@gmail.com
              </a>
              <p class="text-zinc-500 text-xs mt-0.5">Voor boekingen, pers en licenties</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <h4 class="text-white font-semibold text-sm">Telefoon / WhatsApp</h4>
              <a href="tel:+31628884143" class="text-zinc-300 hover:text-white text-sm">
                +31 6 28884143
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Netlify Form (Right) -->
      <div class="lg:col-span-7 bg-[#151720] border border-zinc-800 rounded-2xl p-6 sm:p-10 shadow-2xl">
        <h3 class="text-white font-display text-2xl font-bold mb-6">Stuur een Bericht</h3>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/success"
          class="space-y-6"
        >
          <!-- Netlify requirement -->
          <input type="hidden" name="form-name" value="contact" />

          <!-- Spam filter honeypot -->
          <p class="hidden">
            <label>Niet invullen als je een mens bent: <input name="bot-field" /></label>
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="contact-name" class="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-2">
                Naam *
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Jouw volledige naam"
                class="w-full px-4 py-3 bg-[#0d0e12] border border-zinc-700 rounded-xl text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-2">
                E-mailadres *
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="naam@voorbeeld.nl"
                class="w-full px-4 py-3 bg-[#0d0e12] border border-zinc-700 rounded-xl text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-brand-accent transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-2">
              Onderwerp
            </label>
            <select
              id="contact-subject"
              name="subject"
              class="w-full px-4 py-3 bg-[#0d0e12] border border-zinc-700 rounded-xl text-white text-sm focus:outline-none focus:border-brand-accent transition-colors"
            >
              <option value="Boeking & Optreden">Boeking & Optreden</option>
              <option value="Sync & Muzieklicentie">Sync & Muzieklicentie</option>
              <option value="Productie & Studio">Productie & Studio (Jupiterkade)</option>
              <option value="Pers & Interviews">Pers & Interviews</option>
              <option value="Algemene vraag">Algemene vraag / Bericht</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-2">
              Bericht *
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Vertel over de gelegenheid, datum, locatie of jouw vraag..."
              class="w-full px-4 py-3 bg-[#0d0e12] border border-zinc-700 rounded-xl text-white placeholder-zinc-500 text-sm focus:outline-none focus:border-brand-accent transition-colors"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-3.5 bg-brand-accent hover:bg-orange-500 text-black font-semibold rounded-xl transition-all hover:scale-105 shadow-lg flex items-center justify-center gap-2"
          >
            <span>Verstuur Bericht</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
