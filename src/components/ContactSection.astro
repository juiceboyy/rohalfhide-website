---
---

<section id="contact" class="py-24 bg-surface-void shadow-divider-t">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- Left Column: Coordinates -->
    <div class="lg:col-span-4 space-y-8">
      <div class="space-y-3">
        <h2 class="font-serif font-semibold text-4xl sm:text-5xl tracking-[-0.04em] leading-[1.05] text-surface-ink">
          Contact
        </h2>
        <p class="font-sans font-normal text-base text-surface-muted leading-relaxed">
          For bookings, sync &amp; licensing, or general inquiries.
        </p>
      </div>

      <div class="pt-6 shadow-divider-t space-y-6 text-sm">
        <div class="space-y-1">
          <p class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle">Studio</p>
          <p class="font-sans font-normal text-surface-ink">Jupiterkade 2</p>
          <p class="font-sans font-normal text-surface-muted">The Hague, The Netherlands</p>
        </div>

        <div class="space-y-1">
          <p class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle">Email</p>
          <a
            href="mailto:halfhide@gmail.com"
            class="inline-block font-sans font-normal text-accent hover:text-accent-hover underline underline-offset-4 transition-colors duration-150 rounded-sm focus-ring"
          >
            halfhide@gmail.com
          </a>
        </div>

        <div class="space-y-1">
          <p class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle">Phone</p>
          <a
            href="tel:+31628884143"
            class="inline-block font-mono text-sm text-surface-ink hover:text-accent transition-colors duration-150 rounded-sm focus-ring"
          >
            +31 6 28884143
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Netlify Contact Form -->
    <div class="lg:col-span-8">
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/success"
        class="bg-surface-base rounded-2xl shadow-hairline p-6 sm:p-10 space-y-6"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="contact-name" class="block font-mono font-medium text-xs uppercase tracking-[0.16em] text-surface-muted mb-2">
              Name
            </label>
            <span id="contact-name-hint" class="block text-xs text-surface-subtle mb-2">
              Required
            </span>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              autocomplete="name"
              aria-describedby="contact-name-hint"
              aria-errormessage="contact-name-error"
              class="form-input"
            />
            <p id="contact-name-error" class="field-error items-center gap-2 text-xs text-red-400 mt-2">
              <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
              </svg>
              <span>Please enter your name.</span>
            </p>
          </div>

          <div>
            <label for="contact-email" class="block font-mono font-medium text-xs uppercase tracking-[0.16em] text-surface-muted mb-2">
              Email
            </label>
            <span id="contact-email-hint" class="block text-xs text-surface-subtle mb-2">
              Format: name@example.com
            </span>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              autocomplete="email"
              aria-describedby="contact-email-hint"
              aria-errormessage="contact-email-error"
              class="form-input"
            />
            <p id="contact-email-error" class="field-error items-center gap-2 text-xs text-red-400 mt-2">
              <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
              </svg>
              <span>Please enter a valid email address.</span>
            </p>
          </div>
        </div>

        <div>
          <label for="contact-subject" class="block font-mono font-medium text-xs uppercase tracking-[0.16em] text-surface-muted mb-2">
            Subject
          </label>
          <select id="contact-subject" name="subject" class="form-input">
            <option value="Booking & Live Shows">Booking &amp; Live Shows</option>
            <option value="Sync & Licensing">Sync &amp; Licensing</option>
            <option value="Studio & Production">Studio &amp; Production</option>
            <option value="General Inquiry">General Inquiry</option>
          </select>
        </div>

        <div>
          <label for="contact-message" class="block font-mono font-medium text-xs uppercase tracking-[0.16em] text-surface-muted mb-2">
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            aria-errormessage="contact-message-error"
            class="form-input"
          ></textarea>
          <p id="contact-message-error" class="field-error items-center gap-2 text-xs text-red-400 mt-2">
            <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
            </svg>
            <span>Please include a message.</span>
          </p>
        </div>

        <button
          type="submit"
          class="px-8 py-4 bg-surface-ink hover:bg-white text-surface-void font-mono font-medium text-xs uppercase tracking-[0.16em] rounded-lg transition-colors duration-150 focus-ring"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>
