---
---

<section id="contact" class="py-20 bg-[#0c0d11] border-t border-zinc-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-left">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mb-2">Contact</h2>
      <p class="text-zinc-400 text-sm">
        For bookings, sync & licensing, or general inquiries.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <!-- Info Left -->
      <div class="md:col-span-5 space-y-4 text-sm text-zinc-300">
        <div>
          <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold mb-1">Studio</p>
          <p class="text-white">Jupiterkade 2</p>
          <p class="text-zinc-400">The Hague, The Netherlands</p>
        </div>

        <div>
          <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold mb-1">Email</p>
          <a href="mailto:halfhide@gmail.com" class="text-zinc-200 underline hover:text-white">
            halfhide@gmail.com
          </a>
        </div>

        <div>
          <p class="text-xs uppercase tracking-wider text-zinc-500 font-semibold mb-1">Phone</p>
          <p class="text-zinc-300">+31 6 28884143</p>
        </div>
      </div>

      <!-- Form Right -->
      <div class="md:col-span-7">
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/success"
          class="space-y-4"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs text-zinc-400 mb-1">Name</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded text-white text-sm focus:outline-none focus:border-zinc-500"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs text-zinc-400 mb-1">Email</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded text-white text-sm focus:outline-none focus:border-zinc-500"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs text-zinc-400 mb-1">Subject</label>
            <select
              id="contact-subject"
              name="subject"
              class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded text-white text-sm focus:outline-none focus:border-zinc-500"
            >
              <option value="Booking & Live Shows">Booking & Live Shows</option>
              <option value="Sync & Licensing">Sync & Licensing</option>
              <option value="Studio & Production">Studio & Production</option>
              <option value="General Inquiry">General Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs text-zinc-400 mb-1">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              class="w-full px-3 py-2 bg-zinc-900 border border-zinc-800 rounded text-white text-sm focus:outline-none focus:border-zinc-500"
            ></textarea>
          </div>

          <button
            type="submit"
            class="px-6 py-2.5 bg-white hover:bg-zinc-200 text-black font-medium rounded text-sm transition-colors"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
