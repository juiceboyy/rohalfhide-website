---
interface PastShow {
  date: string;
  venue: string;
  city: string;
}

const pastShows: PastShow[] = [
  {
    date: "Sep 21, 2025",
    venue: "De Vos",
    city: "Tilburg"
  },
  {
    date: "May 25, 2025",
    venue: "Café de Bruine Pij",
    city: "Breda"
  }
];
---

<section id="shows" class="py-20 bg-[#0c0d11] border-t border-zinc-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-left">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mb-2">Shows</h2>
      <p class="text-zinc-400 text-sm">
        Upcoming dates synced via Bandsintown & Spotify.
      </p>
    </div>

    <!-- Bandsintown Widget -->
    <div class="mb-12">
      <a
        class="bit-widget-initializer"
        data-artist-name="Ro Halfhide"
        data-background-color="transparent"
        data-text-color="#FFFFFF"
        data-link-color="#d4af37"
        data-auto-style="true"
        data-display-limit="10"
        data-display-lineup="false"
        data-display-play-my-city="true"
        data-separator-color="rgba(255, 255, 255, 0.08)"
      ></a>
    </div>

    <!-- Past Shows -->
    <div class="pt-8 border-t border-zinc-800/60">
      <h3 class="text-xs uppercase tracking-wider text-zinc-400 font-semibold mb-4">Past Dates</h3>
      <div class="divide-y divide-zinc-800/60">
        {pastShows.map((show) => (
          <div class="py-3 flex items-center justify-between text-sm">
            <span class="font-mono text-zinc-400 text-xs w-28">{show.date}</span>
            <span class="text-zinc-200">{show.venue}</span>
            <span class="text-zinc-400 text-xs">{show.city}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline charset="utf-8" src="https://widget.bandsintown.com/main.min.js"></script>
