---
---

<section id="shows" class="py-24 bg-surface-base shadow-divider-t">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <div class="lg:col-span-4 space-y-4">
      <h2 class="font-serif font-semibold text-4xl sm:text-5xl tracking-[-0.04em] leading-[1.05] text-surface-ink">
        Shows
      </h2>
      <p class="font-sans font-normal text-base text-surface-muted leading-relaxed">
        Live dates, intimate acoustic performances, and tour announcements.
      </p>
    </div>

    <div class="lg:col-span-8 space-y-12">
      <!-- Upcoming Shows Ledger Surface -->
      <div class="bg-surface-raised/60 rounded-2xl shadow-hairline p-6 sm:p-8">
        <div class="flex items-center justify-between pb-6 shadow-divider-b">
          <h3 class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle">
            Upcoming Dates
          </h3>
          <span id="shows-count" class="font-mono text-xs text-surface-muted hidden"></span>
        </div>

        <div id="upcoming-shows-container" class="pt-2">
          <!-- Loading skeleton state -->
          <div id="shows-skeleton" class="space-y-4 py-4 animate-pulse" aria-hidden="true">
            <div class="h-4 bg-white/[0.06] rounded w-3/4"></div>
            <div class="h-4 bg-white/[0.03] rounded w-1/2"></div>
          </div>

          <!-- Empty state: shown when there are no upcoming tour dates -->
          <div id="shows-empty-state" class="hidden py-6 space-y-3">
            <p class="font-serif text-lg sm:text-xl text-surface-ink">
              No upcoming tour dates scheduled at the moment.
            </p>
            <p class="font-sans text-sm text-surface-muted leading-relaxed max-w-xl">
              For intimate house concerts, festival bookings, or private events, please
              <a href="#contact" class="text-accent hover:text-accent-hover underline underline-offset-4 transition-colors">get in touch</a>
              directly or join the
              <a href="#newsletter" class="text-accent hover:text-accent-hover underline underline-offset-4 transition-colors">newsletter</a>
              for upcoming announcements.
            </p>
          </div>

          <!-- Shows list: rendered dynamically when shows exist -->
          <div id="shows-list" class="hidden"></div>

          <!-- Error fallback state -->
          <div id="shows-error-state" class="hidden py-6 space-y-2 text-sm text-surface-muted">
            <p>Schedule updates are temporarily unavailable.</p>
            <p>
              For bookings and live inquiries, please
              <a href="#contact" class="text-accent hover:text-accent-hover underline underline-offset-4 transition-colors">contact Ro directly</a>.
            </p>
          </div>
        </div>
      </div>

      <!-- Past Shows Ledger: rendered dynamically from Bandsintown API -->
      <div id="past-shows-section" class="hidden pt-8 shadow-divider-t">
        <h3 class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle mb-4">
          Past Dates
        </h3>
        <div id="past-shows-list"></div>
      </div>

      <!-- Editorial Bridge: Live & Event Bookings (Reau) -->
      <div class="bg-surface-raised/40 border border-white/[0.06] rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1.5 max-w-xl">
          <p class="font-mono font-medium text-xs uppercase tracking-[0.2em] text-surface-subtle">
            Private Events &amp; Live Bookings
          </p>
          <p class="font-sans text-sm text-surface-muted leading-relaxed">
            Looking to book live music for private events, weddings, corporate functions, or acoustic sets? Discover Ro's dedicated live performance project.
          </p>
        </div>
        <a
          href="https://reaumusic.nl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 bg-surface-raised hover:bg-white/[0.1] text-surface-ink text-xs font-mono font-medium uppercase tracking-[0.16em] rounded-lg transition-colors border border-white/[0.08] shrink-0 focus-ring"
        >
          <span>Discover Reau</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/tour-dates.ts"></script>
